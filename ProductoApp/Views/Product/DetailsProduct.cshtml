@model ProductoApp.Models.Product
@{
    ViewData["Title"] = "DetailsProduct";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-box-seam me-2"></i>
                        Detalle del Producto
                    </h4>
                </div>

                <div class="card-body p-4">

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                Nombre
                            </label>
                            <div class="form-control bg-light">
                                @Model.Nombre
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                Precio
                            </label>
                            <div class="form-control bg-light">
                                @Model.Precio.ToString("N3")
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Descripción
                        </label>
                        <div class="form-control bg-light"
                             style="min-height: 100px; height: auto; white-space: pre-wrap;">
                            @Model.Descripcion
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                Categoría
                            </label>
                            <div class="form-control bg-light">
                                @Model.Categories?.Nombre
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                Proveedor
                            </label>
                            <div class="form-control bg-light">
                                @Model.Proveeder?.Nombre
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between flex-wrap gap-2">

                        <a asp-controller="Product" asp-action="EditProducto" asp-route-id="@Model.Id"
                           class="btn btn-success">
                            <i class="bi bi-pencil-square me-1"></i>
                            Editar producto
                        </a>

                        <a asp-controller="Product"
                           asp-action="ProductIndex"
                            class="btn btn-danger">
                            <i class="bi bi-arrow-left me-1"></i>
                            Cancelar 
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

